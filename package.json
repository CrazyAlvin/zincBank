{
  "name": "zinc-bznk-test-framework",
  "version": "1.0.0",
  "description": "Basic BDD automation framework using Playwright, TypeScript and Cucumber",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "test:chrome": "cross-env BROWSER=chromium cucumber-js",
    "test:firefox": "cross-env BROWSER=firefox cucumber-js",
    "test:webkit": "cross-env BROWSER=webkit cucumber-js",
    "test:headless": "cross-env HEADLESS=true cucumber-js",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:smoke": "cross-env TAGS='@smoke' cucumber-js",
    "test:tag": "cucumber-js --tags",
    "test:US00-AC2": "cross-env HEADLESS=false cucumber-js --tags \"@US00-AC2\"",
    "report": "cucumber-js --format html:reports/cucumber-report.html",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "cucumber",
    "bdd",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "overrides": {
    "@cucumber/messages": "24.1.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "allure-commandline": "^2.43.0",
    "allure-cucumberjs": "^3.10.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
