# Copy .env.example to .env and fill in your values.
# Environment configuration is read by src/config/env.ts

# Base URL of the application under test
BASE_URL=https://zincbank.cydeo.io

# Browser to run tests in: chromium | firefox | webkit
BROWSER=chromium

# Run browser in headless mode: true | false
HEADLESS=true

# Default timeout (ms) for Playwright actions/assertions
TIMEOUT=10000
